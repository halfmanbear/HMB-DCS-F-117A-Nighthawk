# Logs from DCS, Blender and the texture pipeline
*.log

# Local backups and development scratch folders
/_backup_*/
/_input_irads_fix_*/
/_irads_*/

# Generated Blender development outputs
/blender_files/**/build/
/blender_files/**/obj/
/texture_sources/uv_work/finish/.cache/
/texture_sources/uv_work/finish/glass-debug/backups/
/blender_files/**/*.exe
/blender_files/**/*.obj
*.blend[0-9]*
*.blend@
*.bak
*.orig
*.tmp
*~

# Superseded model backups kept next to the live EDMs
/Shapes/old*.edm
/Cockpit/Shape/old*.edm

# Local release packaging and Python caches
/dist/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
/tools/cockpit/layout_editor_backups/
/tools/fm_bench/.cache/
/tools/fm_bench/results/

# Keep only the Blender sources for currently referenced models
/blender_files/*
!/blender_files/README.md
!/blender_files/f-117-nighthawk-exterior.blend
!/blender_files/f-117-nighthawk_canopy.blend
!/blender_files/f-117-nighthawk-oblomok.blend
!/blender_files/integrated_collision/
/blender_files/integrated_collision/*
!/blender_files/integrated_collision/exposed_controls/
/blender_files/integrated_collision/exposed_controls/*
!/blender_files/integrated_collision/exposed_controls/f-117-nighthawk-exposed-controls.blend

# Local scratch renders and migration backups
/tmp/
/texture_sources/uv_work/finish/glass-debug/ufcp-reference.png
/texture_sources/uv_work/finish/glass-debug/dep-reference.png
/texture_sources/uv_work/finish/glass-debug/dep-controls-reference.png
