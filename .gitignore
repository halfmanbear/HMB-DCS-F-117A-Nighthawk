# Local backups and development scratch folders
/_backup_*/
/_input_irads_fix_*/
/_irads_*/

# Superseded model copies
/Cockpit/Shape/old-*.edm
/Shapes/old-*.edm
/Shapes/v1-f-117-nighthawk.edm

# Runtime logs and machine-specific proxy configuration
/bin/*.log
/bin/efm.proxy.ini

# Generated Blender development outputs
/blender_files/**/build/
/blender_files/**/obj/
/blender_files/**/*.log
/blender_files/**/*.exe
/blender_files/**/*.obj
*.blend[0-9]*

# Local release packaging and Python caches
/dist/
__pycache__/
/tools/layout_editor_backups/

# Local-only reference material (manual OCR text; not for distribution)
/docs/reference/
/Lockheed F-117A Nighthawk Utility Flight Manual.pdf

# Keep only the Blender sources for currently referenced models
/blender_files/*
!/blender_files/README.md
!/blender_files/f-117-nighthawk_canopy.blend
!/blender_files/f-117-nighthawk-oblomok.blend
!/blender_files/integrated_collision/
/blender_files/integrated_collision/*
!/blender_files/integrated_collision/exposed_controls/
/blender_files/integrated_collision/exposed_controls/*
!/blender_files/integrated_collision/exposed_controls/f-117-nighthawk-exposed-controls.blend

# Local scratch renders and migration backups
/tmp/
# Generated by tools/generate_display_font.py; the displays now use the stroke font
/Cockpit/Scripts/Resources/FONTS/F117_Display_Bold.dds
